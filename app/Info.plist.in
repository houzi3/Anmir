<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>zh-Hans</string>
        <string>zh-Hant</string>
    </array>
    <key>CFBundleDisplayName</key>
    <string>@SCRCPY_APP_NAME@</string>
    <key>CFBundleExecutable</key>
    <string>anmir</string>
    <key>CFBundleIconFile</key>
    <string>anmir</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.laobie.anmir</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>@SCRCPY_APP_NAME@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Android application package</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>apk</string>
            </array>
            <key>CFBundleTypeIconFile</key>
            <string>anmir-apk.icns</string>
            <key>CFBundleTypeIconSystemGenerated</key>
            <false/>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.android.package-archive</string>
            </array>
            <key>LSTypeIsPackage</key>
            <false/>
        </dict>
    </array>
    <key>CFBundleShortVersionString</key>
    <string>@SCRCPY_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@SCRCPY_VERSION@</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <key>LSMinimumSystemVersion</key>
    <string>@SCRCPY_MINIMUM_SYSTEM_VERSION@</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Find and connect to Android devices for wireless debugging and mirroring.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_adb-tls-pairing._tcp</string>
        <string>_adb-tls-connect._tcp</string>
    </array>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.archive</string>
            </array>
            <key>UTTypeDescription</key>
            <string>Android application package</string>
            <key>UTTypeIconFile</key>
            <string>anmir-apk.icns</string>
            <key>UTTypeIdentifier</key>
            <string>com.android.package-archive</string>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>apk</string>
                </array>
                <key>public.mime-type</key>
                <string>application/vnd.android.package-archive</string>
            </dict>
        </dict>
    </array>
</dict>
</plist>
