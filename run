#!/usr/bin/env bash
# Modified for Anmir; see NOTICE for downstream changes.
# Run Anmir generated in the specified BUILDDIR.
#
# This provides the same feature as "ninja run", except that it is possible to
# pass arguments to Anmir.
#
# Syntax: ./run BUILDDIR <anmir options ...>
if [[ $# = 0 ]]
then
    echo "Syntax: $0 BUILDDIR <anmir options>" >&2
    exit 1
fi

BUILDDIR="$1"
shift

if [[ ! -d "$BUILDDIR" ]]
then
    echo "The build dir \"$BUILDDIR\" does not exist." >&2
    exit 1
fi

SCRCPY_ICON_DIR="app/data" \
SCRCPY_SERVER_PATH="$BUILDDIR/server/scrcpy-server" \
"$BUILDDIR/app/anmir" "$@"
